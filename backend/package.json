{
  "name": "fastvan-backend",
  "version": "0.1.0",
  "description": "Backend Node.js/Express para FastVan",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:rf1": "jest src/__tests__/RF1-cadastro-usuarios.test.js --verbose",
    "db:migrate": "node src/database/runMigrations.js",
    "db:check": "node -e \"require('dotenv').config();require('./src/config/database').testConnection().then((s)=>{console.log(s);process.exit(0);}).catch((e)=>{console.error(e);process.exit(1);})\"",
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "keywords": [
    "van",
    "transporte",
    "passageiros",
    "motoristas"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.0",
    "express": "^4.18.2",
    "pg": "^8.11.2",
    "dotenv": "^16.3.1",
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "@babel/preset-env": "^7.23.3",
    "@babel/preset-react": "^7.23.3",
    "babel-jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.jsx?$": "babel-jest"
    },
    "testMatch": [
      "**/__tests__/**/*.test.js",
      "**/?(*.)+(spec|test).js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/index.js",
      "!src/**/*.test.js"
    ]
  }
}
